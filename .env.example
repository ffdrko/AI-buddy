# --- API ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://study:study@db:5432/study
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=study-raw
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# --- Postgres ---
POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study
# --- LLM (Phase 3+) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# --- Auth (Phase 7) ---
SECRET_KEY=change-me-in-production
APP_ENV=development
# --- DB pool (Phase 7; prod routes via PgBouncer, see docker-compose.prod.yml) ---
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
